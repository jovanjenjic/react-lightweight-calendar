{
  "name": "react-lightweight-calendar",
  "version": "3.0.0",
  "description": "A lightweight, customizable React calendar: month, week, day and timeline views with Google Calendar style layout.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "react-calendar",
    "react-timeline-calendar",
    "react-event-calendar",
    "react-google-calendar",
    "calendar",
    "timeline-calendar",
    "event-calendar",
    "google-calendar",
    "google calendar",
    "event calendar",
    "timeline calendar"
  ],
  "author": "Jovan Jenjic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jovanjenjic/react-lightweight-calendar"
  },
  "scripts": {
    "start": "vite --port 3000",
    "build": "npm run build:js && npm run build:css",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:js": "npm run clean && tsup",
    "build:css": "sass --no-source-map --style=compressed src/styles/calendar.scss dist/styles.css",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint src playground scripts --fix",
    "lint": "eslint src playground scripts",
    "test": "npm run test:unit && cypress run --component --browser chrome",
    "test:open": "cypress open --component",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepublishOnly": "node scripts/release.mjs --guard",
    "test:unit": "TZ=America/New_York vitest run",
    "test:component": "cypress run --component --browser chrome"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-links": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chromatic": "^18.15.2",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "storybook": "^10.6.8",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": "^0.9.1"
  }
}
